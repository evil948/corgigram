{
  "rules": {
    "signaling": {
      "$userId": {
        "offer": {
          ".read": true,
          ".write": true
        },
        "answer": {
          ".read": true,
          ".write": true
        },
        "ice": {
          "$fromUserId": {
            ".read": true,
            "$candidateId": {
              ".read": true,
              ".write": true
            }
          }
        }
      }
    },
    "mailboxes": {
      "$userId": {
        ".read": true,
        "$msgId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "mailbox_pings": {
      "$userId": {
        ".read": true,
        "$fromUserId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "connect_pings": {
      "$userId": {
        ".read": true,
        "$fromUserId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "presence": {
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    "directory": {
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    "avatars": {
      "$ownerId": {
        "$viewerId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "invitations": {
      "$userId": {
        ".read": true,
        "$fromUserId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "avatar_wants": {
      "$ownerId": {
        ".read": true,
        "$viewerId": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
